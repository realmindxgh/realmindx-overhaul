# /etc/systemd/system/realmindx-stale-digest.service
# Runs the RealMindX stale-pending digest on demand and via realmindx-stale-digest.timer.
# Installed and enabled idempotently by the GitHub Actions deploy workflow.
# Copying manually is fine too; the workflow manages this file on the VPS.

[Unit]
Description=RealMindX stale pending digest (teacher apps, book requests, orders)
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=oneshot
User=www-data
Group=www-data
WorkingDirectory=/var/www/realmindx/realmindx-site
Environment="PATH=/var/www/realmindx/realmindx-site/.venv/bin"
EnvironmentFile=/var/www/realmindx/realmindx-site/.env
ExecStart=/var/www/realmindx/realmindx-site/.venv/bin/flask --app backend:create_app send-stale-pending-digest
Nice=10
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=full
UMask=0077
