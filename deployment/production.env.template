# ============================================================
# RealMindX — Production .env for the VPS
# Place this file at: /var/www/realmindx/realmindx-site/.env
# ============================================================

# ── Security ─────────────────────────────────────────────────
# Generate with: python3 -c "import secrets; print(secrets.token_hex(48))"
SECRET_KEY=REPLACE_WITH_NEW_64_CHAR_SECRET_KEY

# ── Database ──────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://realmindx:REPLACE_DB_PASSWORD@127.0.0.1:5432/realmindx

# ── URLs ──────────────────────────────────────────────────────
BASE_URL=https://realmindxgh.com
BOOKSHOP_URL=https://realmindxgh.com/bookshop
API_URL=https://realmindxgh.com/api

# ── CORS & cookies ────────────────────────────────────────────
CORS_ORIGINS=https://realmindxgh.com,https://www.realmindxgh.com
SESSION_COOKIE_SECURE=True
RATELIMIT_STORAGE_URI=memory://

# ── File uploads ──────────────────────────────────────────────
UPLOAD_FOLDER=/var/www/realmindx/realmindx-site/uploads

# ── Email (Resend) ─────────────────────────────────────────────
DEFAULT_FROM_EMAIL=RealMindX <notifications@send.realmindxgh.com>
DEFAULT_REPLY_TO_EMAIL=info@realmindxgh.com
JOBS_FROM_EMAIL=RealMindX Jobs <jobs@send.realmindxgh.com>
BOOKSHOP_FROM_EMAIL=RealMindX Bookshop <bookshop@send.realmindxgh.com>
RESEND_API_KEY=REPLACE_WITH_RESEND_API_KEY
ADMIN_CC_EMAIL=realmindxgh@gmail.com

# ── Payments ─────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=REPLACE_WITH_PAYSTACK_LIVE_SECRET_KEY
PAYSTACK_PUBLIC_KEY=REPLACE_WITH_PAYSTACK_LIVE_PUBLIC_KEY

# ── Arkesel SMS (Ghana) — add when ready; blank = SMS silently skipped ───────
ARKESEL_API_KEY=REPLACE_WITH_ARKESEL_API_KEY
ARKESEL_SENDER_ID=RealMindX

# ── Cloudflare Turnstile ─────────────────────────────────────
TURNSTILE_SECRET_KEY=REPLACE_WITH_TURNSTILE_SECRET_KEY

# ── OAuth social login ────────────────────────────────────────
GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=REPLACE_WITH_GOOGLE_CLIENT_SECRET
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
FACEBOOK_APP_ID=REPLACE_WITH_FACEBOOK_APP_ID
FACEBOOK_APP_SECRET=REPLACE_WITH_FACEBOOK_APP_SECRET
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# ── Admin seed account ────────────────────────────────────────
ADMIN_EMAIL=admin@realmindxgh.com
ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
ADMIN_FIRST_NAME=RealMindX
ADMIN_LAST_NAME=Admin

# ── Google Drive backup (optional) ───────────────────────────
GOOGLE_DRIVE_CREDENTIALS_JSON=
GOOGLE_DRIVE_FOLDER_ID=
