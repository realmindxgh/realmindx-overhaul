# /etc/systemd/system/realmindx-api.service
# Copy this file to /etc/systemd/system/ on the VPS
# Then: sudo systemctl daemon-reload && sudo systemctl enable realmindx-api

[Unit]
Description=RealMindX Flask API (gunicorn)
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=notify
User=www-data
Group=www-data
WorkingDirectory=/var/www/realmindx/realmindx-site
Environment="PATH=/var/www/realmindx/realmindx-site/.venv/bin"
EnvironmentFile=/var/www/realmindx/realmindx-site/.env
ExecStart=/var/www/realmindx/realmindx-site/.venv/bin/gunicorn \
    --workers 2 \
    --bind 127.0.0.1:5001 \
    --timeout 120 \
    --access-logfile /var/log/realmindx/api-access.log \
    --error-logfile  /var/log/realmindx/api-error.log \
    "backend:create_app()"
ExecReload=/bin/kill -s HUP $MAINPID
KillMode=mixed
TimeoutStopSec=5
PrivateTmp=true
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
