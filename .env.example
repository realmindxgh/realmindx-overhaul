# App URLs
VITE_PUBLIC_SITE_URL=http://127.0.0.1:5173
VITE_BOOKSHOP_URL=http://127.0.0.1:5173/bookshop

# Flask API base (must include the /api suffix).
# LEAVE EMPTY for local mode: the app runs entirely on the localStorage
# data layer (managedContent.js + demoAccounts.js). Set it to point the
# app at the running Flask backend — public forms, orders, and auth then
# go over the API instead of localStorage. Nothing else needs to change.
#   Local mode (default):   VITE_API_BASE_URL=
#   Backend mode:           VITE_API_BASE_URL=/api
VITE_API_BASE_URL=

# Operational security rollout. Keep the enforcement flag false until a
# shared Redis endpoint has been configured and verified in staging.
RATELIMIT_STORAGE_URI=memory://
REQUIRE_SHARED_RATE_LIMIT_STORAGE=false

# Privileged accounts are prompted, but not blocked, while administrators and
# staff enroll in email two-factor authentication.
PRIVILEGED_MFA_MODE=prompt

# Optional ClamAV upload scanning. Install and verify clamd + clamdscan before
# enabling; uploads fail safely with a retryable message if the scanner is down.
UPLOAD_MALWARE_SCANNING_ENABLED=false
UPLOAD_MALWARE_SCANNER_PATH=clamdscan
UPLOAD_MALWARE_SCAN_TIMEOUT_SECONDS=30

# Per-recipient SMS send timeout in seconds (connection + read combined).
# Each recipient gets an independent window; a slow response marks only that
# recipient as "unknown" so the rest of the batch continues immediately.
SMS_SEND_TIMEOUT=5

# Paystack (public key goes here AND in realmindx-site/.env as PAYSTACK_PUBLIC_KEY)
VITE_PAYSTACK_PUBLIC_KEY=

# Email identities for backend phase
DEFAULT_FROM_EMAIL=RealMindX <notifications@send.realmindxgh.com>
DEFAULT_REPLY_TO_EMAIL=info@realmindxgh.com
JOBS_FROM_EMAIL=RealMindX Jobs <jobs@send.realmindxgh.com>
BOOKSHOP_FROM_EMAIL=RealMindX Bookshop <bookshop@send.realmindxgh.com>
NEWSLETTER_FROM_EMAIL=RealMindX News <news@send.realmindxgh.com>
SALES_FROM_EMAIL=RealMindX Sales <sales@send.realmindxgh.com>
# Comma-separated admin alert recipients for operational alerts (teacher submissions, job apps, book requests, etc.)
ADMIN_ALERT_EMAILS=info@realmindxgh.com,iasare@realmindxgh.com

# CAPTCHA / Turnstile placeholders
TURNSTILE_SECRET_KEY=
# Local visible test key; replace with your real Cloudflare Turnstile site key in production.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
