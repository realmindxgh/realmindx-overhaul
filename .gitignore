node_modules/
dist/

# Environment files (never commit secrets)
.env
.env.*
!.env.example
*.pem
*.key
*.p8
credentials*.json
service-account*.json
secrets*.json

# Python
venv/
.venv/
__pycache__/
.pytest_cache/
*.pyc
*.pyo

# Local databases (use PostgreSQL in production)
*.db
*.sqlite
*.sqlite3

# Temporary debug files
tmp-*.mjs
tmp-*.js
*.debug.js

# Browser automation profiles (CDP user-data-dirs) - these contain real
# cookies/passwords/history from whatever session created them. Never commit.
.tmp-*-cdp/
.tmp-edge-cdp/
.tmp-chrome-cdp/

# Uploads (managed by the server, not git)
realmindx-site/uploads/*
!realmindx-site/uploads/.gitkeep
!realmindx-site/uploads/Redesign/
!realmindx-site/uploads/Redesign/**

# Generated caches and QA artifacts
realmindx-site/.pytest_cache/
.vite-codex-cache/
dist-codex/
.qa-shots/
tmp/
realmindx-site/tmp/
.codex-remote-attachments/
artifacts/

# Logs
*.log
logs/
screenshots/
.local-pg/
.claude/
opencode.json
